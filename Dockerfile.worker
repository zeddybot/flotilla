FROM node:22.22.0-bookworm-slim AS engines
RUN npm install -g @anthropic-ai/claude-code@2.1.284 @openai/codex@0.155.1

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 worker
COPY --from=engines /usr/local/bin/node /usr/local/bin/node
COPY --from=engines /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude \
    && ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && claude --version && codex --version
COPY --from=ghcr.io/astral-sh/uv:0.12.6 /uv /uvx /usr/local/bin/
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts/worker_entrypoint.py ./scripts/
RUN uv sync --frozen --no-dev --no-editable \
    && mkdir -p /data/config /data/state /data/workspaces /data/repos \
    && chown -R worker:worker /data
ENV PATH="/app/.venv/bin:${PATH}" PYTHONUNBUFFERED=1
USER worker
ENTRYPOINT ["python", "/app/scripts/worker_entrypoint.py"]
