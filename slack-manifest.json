{
  "display_information": {
    "name": "Flotilla",
    "description": "Run coding agents from Slack and follow their work in the thread.",
    "background_color": "#2359df"
  },
  "features": {
    "bot_user": {"display_name": "flotilla", "always_online": true},
    "app_home": {"home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false}
  },
  "oauth_config": {
    "scopes": {"bot": ["app_mentions:read", "chat:write", "channels:history", "groups:history", "im:history", "users:read", "files:write", "files:read"]}
  },
  "settings": {
    "event_subscriptions": {"bot_events": ["app_mention", "message.channels", "message.groups", "message.im"]},
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
